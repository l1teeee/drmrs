{
  "name": "drmr",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build",
    "db:start": "node --env-file-if-exists=.env.local scripts/local-db.mjs start",
    "db:stop": "node --env-file-if-exists=.env.local scripts/local-db.mjs stop",
    "db:status": "node --env-file-if-exists=.env.local scripts/local-db.mjs status",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/db-migrate.mjs",
    "admin": "node --env-file-if-exists=.env.local scripts/admin.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@react-three/fiber": "^9.8.2",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "next": "16.4.6",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "^0.186.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
