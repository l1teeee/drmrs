# URL pública del sitio para metadata, Open Graph y sitemap (ej. https://drmr.com.mx)
# Obligatoria en producción (HTTPS). Si el host no es exactamente drmr.com.mx, el sitio se publica con noindex y robots.txt bloquea todo.
NEXT_PUBLIC_SITE_URL=
VERCEL_PROJECT_PRODUCTION_URL=

# Server environment: local, test, preview or production.
APP_ENV=local
# PostgreSQL URL; TLS query parameters are forbidden.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54330/drmr_dev
# TLS: disable only for local databases; verify-ca for Railway; verify-full for providers with publicly trusted certificates.
DATABASE_SSL_MODE=disable
# Railway verify-ca requires the root CA PEM: openssl s_client -starttls postgres -connect <proxy-host>:<port> -showcerts (take the last certificate); optional for verify-full with a public CA.
DATABASE_CA_CERT=
# Maximum number of connections per server pool.
DATABASE_POOL_MAX=10
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET=
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PII_ENCRYPTION_KEY=
# Public application URL; preview and production require HTTPS and a non-local host.
APP_BASE_URL=http://localhost:3000
# Rate limiting: enforce or disabled; protected environments require enforce.
RATE_LIMIT_MODE=enforce
# Bot protection: turnstile or disabled; disabled is for local development only.
BOT_PROTECTION_MODE=disabled
# Site key pública del widget de Cloudflare Turnstile (debe corresponder a TURNSTILE_SECRET_KEY y al hostname del despliegue)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Turnstile server secret required in turnstile mode; no test keys in protected environments.
TURNSTILE_SECRET_KEY=
# Comma-separated allowed hostnames required in turnstile mode; no local hosts in protected environments.
TURNSTILE_ALLOWED_HOSTNAMES=
# Set automatically by Vercel; requires VERCEL_ENV when present.
VERCEL=
# Set automatically by Vercel: development maps to local, preview to preview, production to production.
VERCEL_ENV=
# Messaging: disabled, log (local/test only), or instagram.
MESSAGING_MODE=disabled
# Meta app ID (digits) for unified login (Facebook Login for Business); set all three unified values, or leave all three empty and set INSTAGRAM_APP_ID and INSTAGRAM_APP_SECRET for Instagram Login.
META_APP_ID=
# Meta app secret (at least 16 characters) for unified login; set all three unified values, or leave all three empty and set INSTAGRAM_APP_ID and INSTAGRAM_APP_SECRET for Instagram Login.
META_APP_SECRET=
# Facebook Login for Business configuration ID (digits) for unified login; set all three unified values, or leave all three empty and set INSTAGRAM_APP_ID and INSTAGRAM_APP_SECRET for Instagram Login.
INSTAGRAM_LOGIN_CONFIG_ID=
# Instagram Login app ID (digits); used when the three unified login values are empty.
INSTAGRAM_APP_ID=
# Instagram Login app secret (at least 16 characters); also verifies that app's webhook signatures.
INSTAGRAM_APP_SECRET=
# Webhook verification token (at least 16 characters); required in instagram mode.
META_WEBHOOK_VERIFY_TOKEN=
# Base64 encryption key for exactly 32 bytes; required in instagram mode.
INSTAGRAM_TOKEN_ENCRYPTION_KEY=
# Only this lowercase professional Instagram username may connect; required in instagram mode unless INSTAGRAM_ALLOW_ANY_ACCOUNT=true.
INSTAGRAM_BUSINESS_USERNAME=
# true = any professional Instagram account may connect (share exactly one in the Meta dialog) and the ig.me link uses the connected account's username; empty = only INSTAGRAM_BUSINESS_USERNAME.
INSTAGRAM_ALLOW_ANY_ACCOUNT=
# HTTPS Graph API base URL for unified login, ending with /v<major>.<minor>.
META_GRAPH_API_BASE_URL=https://graph.facebook.com/v27.0
# HTTPS Graph API base URL for Instagram Login, ending with /v<major>.<minor>.
INSTAGRAM_GRAPH_API_BASE_URL=https://graph.instagram.com/v26.0
# Cron bearer secret; at least 32 characters required for instagram in preview/production.
CRON_SECRET=
